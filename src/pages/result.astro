---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteCopy } from '../data/copy.ts';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="测试结果 | PLTI" description={siteCopy.resultIntro} path={`${base}result`}>
  <section class="result-shell">
    <div class="section-heading">
      <p class="section-kicker">Result</p>
      <h1 class="page-title">你的语言画像会在这里展开。</h1>
      <p class="page-lede">{siteCopy.resultIntro}</p>
    </div>

    <section class="empty-card" data-empty-state>
      <p class="overline">No Result Yet</p>
      <h2>这里还没有可展示的结果。</h2>
      <p>你还没完成测试，或者分享链接里的答案串无效。先去答题，PLTI 才能认真地把你映射到某门语言上。</p>
    </section>

    <section class="result-hero" data-result-content hidden>
      <article class="result-card result-card--hero" data-capture-card>
        <header>
          <div>
            <p class="overline">Top Match</p>
            <h2 class="result-title" data-result-title></h2>
          </div>
          <span class="fit-badge" data-result-fit></span>
        </header>

        <p class="result-summary" data-result-summary></p>

        <div>
          <p class="overline">Shareable Link</p>
          <div class="share-box">
            <input data-share-input readonly type="text" value="" />
            <button class="button" data-copy-button type="button">复制链接</button>
          </div>
          <p class="share-note" data-share-note hidden></p>
        </div>
      </article>


      <div class="result-grid">
        <section class="meter-stack" data-meter-stack></section>

        <div class="facts-and-alt">
          <div class="alt-grid" data-alt-grid></div>
          <div class="facts-grid" data-facts-grid></div>
        </div>
      </div>
    </section>
  </section>

  <script>
    import { dimensions, dimensionOrder } from '../data/dimensions.ts';
    import {
      PLTI_VERSION,
      buildResultSnapshot,
      decodeAnswerString,
      getDimensionLean,
      getLanguageProfile,
      isCompleteProgress
    } from '../lib/plti.ts';
    import { loadProgress, loadSavedResult, saveResult } from '../lib/storage.ts';

    const base = import.meta.env.BASE_URL;
    const emptyState = document.querySelector('[data-empty-state]');
    const resultContent = document.querySelector('[data-result-content]');
    const titleNode = document.querySelector('[data-result-title]');
    const fitNode = document.querySelector('[data-result-fit]');
    const summaryNode = document.querySelector('[data-result-summary]');
    const altGrid = document.querySelector('[data-alt-grid]');
    const meterStack = document.querySelector('[data-meter-stack]');
    const whyFitList = document.querySelector('[data-why-fit-list]');
    const caveatCopy = document.querySelector('[data-caveat-copy]');
    const factsGrid = document.querySelector('[data-facts-grid]');
    const shareInput = document.querySelector('[data-share-input]');
    const copyButton = document.querySelector('[data-copy-button]');
    const shareNote = document.querySelector('[data-share-note]');

    function resolveAnswers() {
      const currentUrl = new URL(window.location.href);
      const fromQuery = currentUrl.searchParams.get('v') === PLTI_VERSION ? decodeAnswerString(currentUrl.searchParams.get('a')) : null;
      if (fromQuery) {
        return fromQuery;
      }

      const fromSavedResult = loadSavedResult();
      if (fromSavedResult) {
        return fromSavedResult;
      }

      const fromProgress = loadProgress();
      if (fromProgress && isCompleteProgress(fromProgress)) {
        return fromProgress;
      }

      return null;
    }

    function updateShareStatus(message = '') {
      if (!(shareNote instanceof HTMLElement)) {
        return;
      }

      shareNote.hidden = !message;
      shareNote.textContent = message;
    }

    const answers = resolveAnswers();
    if (!answers) {
      if (resultContent instanceof HTMLElement) {
        resultContent.hidden = true;
      }
    } else {
      saveResult(answers);

      const snapshot = buildResultSnapshot(answers);
      const topMatch = snapshot.ranking[0];
      const topLanguage = getLanguageProfile(topMatch.languageId);

      if (!topLanguage) {
        throw new Error('Top language profile is missing.');
      }

      const canonicalUrl = new URL(`${base}result`, window.location.origin);
      canonicalUrl.searchParams.set('v', PLTI_VERSION);
      canonicalUrl.searchParams.set('a', snapshot.answers);
      window.history.replaceState({}, '', canonicalUrl.toString());

      if (emptyState instanceof HTMLElement) {
        emptyState.hidden = true;
      }

      if (resultContent instanceof HTMLElement) {
        resultContent.hidden = false;
      }

      if (titleNode instanceof HTMLElement) {
        titleNode.textContent = `${topLanguage.personaTitle} · ${topLanguage.name}`;
      }

      if (fitNode instanceof HTMLElement) {
        fitNode.textContent = `匹配度 ${topMatch.fit}%`;
      }

      if (summaryNode instanceof HTMLElement) {
        summaryNode.textContent = topLanguage.summary;
      }

      if (shareInput instanceof HTMLInputElement) {
        shareInput.value = canonicalUrl.toString();
      }

      if (altGrid instanceof HTMLElement) {
        altGrid.innerHTML = snapshot.ranking.slice(1, 3).map((entry) => {
          const language = getLanguageProfile(entry.languageId);
          if (!language) {
            return '';
          }

          return `
            <article class="alt-card">
              <div class="tag-row">
                <span class="score-badge">备选结果</span>
                <span class="fit-badge">${entry.fit}%</span>
              </div>
              <h3>${language.personaTitle} · ${language.name}</h3>
              <p>${language.summary}</p>
            </article>
          `;
        }).join('');
      }

      if (meterStack instanceof HTMLElement) {
        meterStack.innerHTML = dimensions.map((dimension) => {
          const score = snapshot.displayScores[dimension.id];
          const lean = getDimensionLean(dimension.id, score);
          const width = `${Math.abs(score) / 2}%`;
          const leftStyle = score < 0 ? `style="width:${width};"` : 'style="width:0;"';
          const rightStyle = score > 0 ? `style="width:${width};"` : 'style="width:0;"';

          return `
            <article class="meter-card">
              <div class="meter-head">
                <div>
                  <p class="overline">${dimension.name}</p>
                  <h3>${lean.title}</h3>
                </div>
                <span class="score-badge">${score > 0 ? '+' : ''}${score}</span>
              </div>
              <div class="meter-track">
                <div class="meter-fill-left" ${leftStyle}></div>
                <div class="meter-fill-right" ${rightStyle}></div>
              </div>
              <div class="meter-labels">
                <span>${dimension.leftTitle}</span>
                <span>${dimension.rightTitle}</span>
              </div>
              <p>${lean.description}</p>
            </article>
          `;
        }).join('');
      }

      if (whyFitList instanceof HTMLElement) {
        whyFitList.innerHTML = topLanguage.whyFit.map((item) => `<li>${item}</li>`).join('');
      }

      if (caveatCopy instanceof HTMLElement) {
        caveatCopy.textContent = topLanguage.caveat;
      }

      if (factsGrid instanceof HTMLElement) {
        const dominantDimensions = [...dimensionOrder]
          .sort((left, right) => Math.abs(snapshot.displayScores[right]) - Math.abs(snapshot.displayScores[left]))
          .slice(0, 2)
          .map((dimensionId) => {
            const dimension = dimensions.find((entry) => entry.id === dimensionId);
            const lean = getDimensionLean(dimensionId, snapshot.displayScores[dimensionId]);
            return `${dimension?.name}：${lean.anchor}`;
          });

        factsGrid.innerHTML = `
          <article class="soft-card">
            <p class="overline">Why This Match</p>
            <h3>为什么会是这门语言</h3>
            <ul class="quote-list">${
              topLanguage.whyFit.map((item) => `<li>${item}</li>`).join('')
            }</ul>
          </article>
          <article class="soft-card">
            <p class="overline">One Gentle Warning</p>
            <h3>也许会卡住你的地方</h3>
            <p>${
              topLanguage.caveat
            }</p>
          </article>
          <article class="soft-card">
            <p class="overline">Code Catchphrase</p>
            <h3>${topLanguage.catchphrase}</h3>
            <p>这大概就是你在代码评审里最容易说出口的话。</p>
          </article>
          <article class="soft-card">
            <p class="overline">Blind Spot</p>
            <h3>${topLanguage.blindspot}</h3>
            <p>每种语言气质都有代价。你的代价，通常出现在这类场景里。</p>
          </article>
          <article class="soft-card">
            <p class="overline">Ideal Team</p>
            <h3>${topLanguage.idealTeam}</h3>
            <p>你最舒服的协作环境，大概率会长成这样。</p>
          </article>
          <article class="soft-card">
            <p class="overline">Strongest Axes</p>
            <h3>${dominantDimensions.join(' · ')}</h3>
            <p>这是你这次画像里最明显的两条轴线，也最影响最终匹配结果。</p>
          </article>
        `;
      }

      copyButton?.addEventListener('click', async () => {
        if (!(shareInput instanceof HTMLInputElement)) {
          return;
        }

        try {
          await navigator.clipboard.writeText(shareInput.value);
          updateShareStatus('结果链接已复制，可以直接发给别人。');
        } catch {
          shareInput.select();
          updateShareStatus('自动复制失败了，但链接已经选中，你可以手动复制。');
        }
      });
    }
  </script>
</BaseLayout>

