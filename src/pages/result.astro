---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResultApp from '../components/result/ResultApp.vue';
import { siteCopy } from '../data/copy.ts';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="测试结果 | PLTI" description={siteCopy.resultIntro} path={`${base}result`}>
  <ResultApp client:only="vue" base={base} />
</BaseLayout>
