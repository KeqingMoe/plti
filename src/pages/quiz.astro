---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteCopy } from '../data/copy.ts';
import { dimensions } from '../data/dimensions.ts';
import { questionPages } from '../data/questions.ts';

const base = import.meta.env.BASE_URL;
const title = '开始测试 | PLTI';
const dimensionById = new Map(dimensions.map((dimension) => [dimension.id, dimension]));
const categoryLabel: Record<string, string> = {
  theory: 'PLT 视角',
  engineering: '工程视角',
  team: '协作视角'
};
---

<BaseLayout title={title} description="完成 60 道题，生成你的编程语言人格画像。" path={`${base}quiz`}>
  <section class="quiz-shell">
    <div class="section-heading">
      <p class="quiz-kicker">Quiz</p>
      <h1 class="page-title">60 道题，做出一份像样的语言画像。</h1>
      <p class="page-lede">每题都没有中立选项。你需要在两种倾向之间做出轻微到强烈的偏向选择。答题进度会自动保存在本地，刷新页面也不会丢。</p>
    </div>

    <section class="paper-card" style="padding: 24px;">
      <p class="restore-note" data-restore-note hidden></p>
      <p class="status-note" data-status-note hidden></p>

      <form id="quiz-form" novalidate>
        <div class="quiz-page-list">
          {questionPages.map((page, pageIndex) => (
            <section class:list={["quiz-page", pageIndex === 0 && 'is-active']} data-quiz-page data-page-index={pageIndex}>
              {page.map((question, questionIndex) => {
                const dimension = dimensionById.get(question.dimension);
                const overallIndex = pageIndex * 10 + questionIndex;

                return (
                  <article class="question-card">
                    <header>
                      <div>
                        <p class="question-index">第 {overallIndex + 1} 题 · {dimension?.name}</p>
                        <h3>{question.prompt}</h3>
                      </div>
                    </header>

                    <div class="contrast-row">
                      <div class="contrast-side">
                        <strong>左侧倾向</strong>
                        <p>{question.leftLabel}</p>
                      </div>
                      <div class="contrast-separator">vs.</div>
                      <div class="contrast-side">
                        <strong>右侧倾向</strong>
                        <p>{question.rightLabel}</p>
                      </div>
                    </div>

                    <div class="choice-grid" role="radiogroup" aria-label={`第 ${overallIndex + 1} 题作答`}>
                      {siteCopy.answerLabels.map((label, answerIndex) => {
                        const inputId = `${question.id}-${answerIndex}`;

                        return (
                          <label class="choice-option" for={inputId}>
                            <input
                              id={inputId}
                              data-question-index={overallIndex}
                              name={question.id}
                              type="radio"
                              value={answerIndex}
                            />
                            <span>{label}</span>
                          </label>
                        );
                      })}
                    </div>
                  </article>
                );
              })}
            </section>
          ))}
        </div>

        <div class="quiz-footer">
          <div class="page-pills">
            {questionPages.map((_, pageIndex) => (
              <span class:list={["page-pill", pageIndex === 0 && 'is-active']} data-page-pill>
                第 {pageIndex + 1} 页
              </span>
            ))}
          </div>

          <div class="quiz-actions">
            <button class="button-ghost" data-reset-button type="button">清空重做</button>
            <button class="button-secondary" data-prev-button type="button">上一页</button>
            <button class="button" data-next-button type="button">下一页</button>
          </div>
        </div>
      </form>
    </section>
  </section>

  <script>
    import {
      PLTI_VERSION,
      QUIZ_PAGE_SIZE,
      TOTAL_QUESTIONS,
      createEmptyProgress,
      encodeAnswerString,
      getAnsweredCount,
      getFirstIncompletePage,
      isAnswerIndex,
      isCompleteProgress,
      questionPages
    } from '../lib/plti.ts';
    import { clearProgress, clearSavedResult, loadProgress, loadSavedResult, saveProgress, saveResult } from '../lib/storage.ts';

    const base = import.meta.env.BASE_URL;
    const form = document.querySelector('#quiz-form');
    const pageElements = Array.from(document.querySelectorAll('[data-quiz-page]'));
    const pagePills = Array.from(document.querySelectorAll('[data-page-pill]'));
    const progressFill = document.querySelector('[data-progress-fill]');
    const progressCount = document.querySelector('[data-progress-count]');
    const progressCopy = document.querySelector('[data-progress-copy]');
    const restoreNote = document.querySelector('[data-restore-note]');
    const statusNote = document.querySelector('[data-status-note]');
    const prevButton = document.querySelector('[data-prev-button]');
    const nextButton = document.querySelector('[data-next-button]');
    const resetButton = document.querySelector('[data-reset-button]');
    const answerInputs = Array.from(document.querySelectorAll('input[data-question-index]'));

    let answers = loadProgress() ?? createEmptyProgress();
    let currentPageIndex = 0;

    const url = new URL(window.location.href);
    if (url.searchParams.get('restart') === '1') {
      answers = createEmptyProgress();
      clearProgress();
      clearSavedResult();
      url.searchParams.delete('restart');
      window.history.replaceState({}, '', url.toString());
    }

    const savedResult = loadSavedResult();
    currentPageIndex = Math.max(0, Math.min(questionPages.length - 1, getFirstIncompletePage(answers)));

    function setStatus(message = '', tone = 'info') {
      if (!(statusNote instanceof HTMLElement)) {
        return;
      }

      if (!message) {
        statusNote.hidden = true;
        statusNote.textContent = '';
        statusNote.classList.remove('is-warning');
        return;
      }

      statusNote.hidden = false;
      statusNote.textContent = message;
      statusNote.classList.toggle('is-warning', tone === 'warning');
    }

    function updateRestoreNote() {
      if (!(restoreNote instanceof HTMLElement)) {
        return;
      }

      const answered = getAnsweredCount(answers);
      if (answered === 0 && !savedResult) {
        restoreNote.hidden = true;
        restoreNote.textContent = '';
        return;
      }

      const fragments = [];
      if (answered > 0) {
        fragments.push(`已恢复本地进度：${answered} / ${TOTAL_QUESTIONS} 题。`);
      }
      if (savedResult) {
        fragments.push('如果你上次已经做完，也可以直接去结果页查看。');
      }

      restoreNote.hidden = false;
      restoreNote.textContent = fragments.join(' ');
    }

    function renderAnswers() {
      answerInputs.forEach((input) => {
        if (!(input instanceof HTMLInputElement)) {
          return;
        }

        const questionIndex = Number(input.dataset.questionIndex);
        input.checked = answers[questionIndex] === Number(input.value);
      });
    }

    function renderProgress() {
      const answered = getAnsweredCount(answers);

      if (progressFill instanceof HTMLElement) {
        progressFill.style.width = `${(answered / TOTAL_QUESTIONS) * 100}%`;
      }

      if (progressCount instanceof HTMLElement) {
        progressCount.textContent = `${answered} / ${TOTAL_QUESTIONS}`;
      }

      if (progressCopy instanceof HTMLElement) {
        progressCopy.textContent = `第 ${currentPageIndex + 1} 页，共 ${questionPages.length} 页。`;
      }
    }

    function renderPages() {
      pageElements.forEach((pageElement, pageIndex) => {
        pageElement.classList.toggle('is-active', pageIndex === currentPageIndex);
      });

      pagePills.forEach((pill, pageIndex) => {
        pill.classList.toggle('is-active', pageIndex === currentPageIndex);
      });

      if (prevButton instanceof HTMLButtonElement) {
        prevButton.disabled = currentPageIndex === 0;
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.textContent = currentPageIndex === questionPages.length - 1 ? '生成结果' : '下一页';
      }
    }

    function renderAll() {
      renderAnswers();
      renderPages();
      renderProgress();
      updateRestoreNote();
    }

    function pageIsComplete(pageIndex) {
      const start = pageIndex * QUIZ_PAGE_SIZE;
      const end = start + QUIZ_PAGE_SIZE;
      return answers.slice(start, end).every(isAnswerIndex);
    }

    function goToResult() {
      if (!isCompleteProgress(answers)) {
        setStatus('还有题目没有完成，先把所有页答完再生成结果。', 'warning');
        return;
      }

      saveProgress(answers);
      saveResult(answers);

      const resultUrl = new URL(`${base}result`, window.location.origin);
      resultUrl.searchParams.set('v', PLTI_VERSION);
      resultUrl.searchParams.set('a', encodeAnswerString(answers));
      window.location.assign(resultUrl.toString());
    }

    answerInputs.forEach((input) => {
      input.addEventListener('change', (event) => {
        const target = event.currentTarget;
        if (!(target instanceof HTMLInputElement)) {
          return;
        }

        const questionIndex = Number(target.dataset.questionIndex);
        const answerIndex = Number(target.value);
        if (!Number.isInteger(questionIndex) || !isAnswerIndex(answerIndex)) {
          return;
        }

        answers[questionIndex] = answerIndex;
        saveProgress(answers);
        renderProgress();
        setStatus('');
      });
    });

    prevButton?.addEventListener('click', () => {
      currentPageIndex = Math.max(0, currentPageIndex - 1);
      setStatus('');
      renderAll();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    nextButton?.addEventListener('click', () => {
      if (!pageIsComplete(currentPageIndex)) {
        setStatus('这一页还没答完。PLTI 不允许带着空题翻页。', 'warning');
        return;
      }

      if (currentPageIndex === questionPages.length - 1) {
        goToResult();
        return;
      }

      currentPageIndex += 1;
      setStatus('');
      renderAll();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    resetButton?.addEventListener('click', () => {
      const shouldReset = window.confirm('这会清空当前答题进度和上一次结果。确定要重新开始吗？');
      if (!shouldReset) {
        return;
      }

      answers = createEmptyProgress();
      currentPageIndex = 0;
      clearProgress();
      clearSavedResult();
      renderAll();
      setStatus('进度已清空，可以重新答题了。');
      form?.reset();
    });

    renderAll();
  </script>
</BaseLayout>

