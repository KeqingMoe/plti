---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuizApp from '../components/quiz/QuizApp.vue';

const base = import.meta.env.BASE_URL;
const title = '开始测试 | PLTI';
---

<BaseLayout title={title} description="完成 60 道题，生成你的编程语言人格画像。" path={`${base}quiz`}>
  <QuizApp client:only="vue" base={base} />
</BaseLayout>
