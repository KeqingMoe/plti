---
import BaseLayout from "../layouts/BaseLayout.astro";
import DimensionSection from "../components/home/DimensionSection.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HowItWorksSection from "../components/home/HowItWorksSection.astro";
import LanguagePoolSection from "../components/home/LanguagePoolSection.astro";
import { siteCopy } from "../data/copy.ts";
import { dimensions } from "../data/dimensions.ts";
import { languages } from "../data/languages.ts";

const base = import.meta.env.BASE_URL;
const title = "PLTI | 编程语言人格测试";

---

<BaseLayout title={title} description={siteCopy.heroBlurb} path={base}>
  <HomeHero
    base={base}
    heroEyebrow={siteCopy.heroEyebrow}
    heroTitle={siteCopy.heroTitle}
    heroBlurb={siteCopy.heroBlurb}
  />
  <HowItWorksSection />
  <DimensionSection dimensions={dimensions} />
  <LanguagePoolSection languages={languages} />
</BaseLayout>
