---
interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = "/" } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const navigation = [
  { href: `${base}`, label: "首页" },
  { href: `${base}quiz`, label: "开始测试" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-backdrop" aria-hidden="true">
      <div class="site-backdrop__orb site-backdrop__orb--one"></div>
      <div class="site-backdrop__orb site-backdrop__orb--two"></div>
      <div class="site-backdrop__grid"></div>
    </div>

    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href={base}>
          <span class="brand__mark">PLTI</span>
          <span class="brand__text">
            <strong>编程语言人格测试</strong>
            <small>把语言偏好做成一份 MBTI 风格的测试</small>
          </span>
        </a>
      </header>

      <main class="main-shell">
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          PLTI
          是一份受编程语言理论与现实工程偏好启发的趣味量表，不是经过心理测量学验证的正式测试。测评仅供娱乐，请勿上纲上线。
        </p>
        <p>© 2026 時雨てる · <a href="https://github.com/KeqingMoe/plti">GitHub Repo</a></p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f4ecdf;
    --paper: rgba(255, 250, 243, 0.84);
    --paper-strong: #fffaf2;
    --paper-deep: #f1e4d0;
    --ink: #1f1c1b;
    --ink-soft: #4c433d;
    --muted: #73685d;
    --line: rgba(74, 53, 38, 0.16);
    --accent: #c55a34;
    --accent-strong: #a54422;
    --accent-soft: rgba(197, 90, 52, 0.14);
    --teal: #204d59;
    --teal-soft: rgba(32, 77, 89, 0.14);
    --gold: #b18618;
    --gold-soft: rgba(177, 134, 24, 0.14);
    --shadow: 0 24px 80px rgba(77, 53, 26, 0.12);
    --radius-lg: 28px;
    --radius-md: 18px;
    --radius-sm: 12px;
    --content-width: min(1120px, calc(100vw - 32px));
    --display-font: 'Iowan Old Style', 'Palatino Linotype', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif;
    --body-font: 'Avenir Next', 'Helvetica Neue', 'Noto Sans SC', 'PingFang SC', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(197, 90, 52, 0.18), transparent 32%),
      radial-gradient(circle at bottom right, rgba(32, 77, 89, 0.14), transparent 28%),
      linear-gradient(180deg, #f8f2e8 0%, #f4ecdf 52%, #efe4d2 100%);
    color: var(--ink);
    font-family: var(--body-font);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  button {
    cursor: pointer;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  [hidden] {
    display: none !important;
  }

  .site-backdrop {
    inset: 0;
    pointer-events: none;
    position: fixed;
    z-index: 0;
  }

  .site-backdrop__orb {
    border-radius: 999px;
    filter: blur(24px);
    opacity: 0.7;
    position: absolute;
  }

  .site-backdrop__orb--one {
    background: rgba(197, 90, 52, 0.18);
    height: 18rem;
    left: -5rem;
    top: 4rem;
    width: 18rem;
  }

  .site-backdrop__orb--two {
    background: rgba(32, 77, 89, 0.14);
    bottom: 8rem;
    height: 22rem;
    right: -6rem;
    width: 22rem;
  }

  .site-backdrop__grid {
    background-image:
      linear-gradient(rgba(90, 70, 54, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(90, 70, 54, 0.06) 1px, transparent 1px);
    background-position: center;
    background-size: 22px 22px;
    inset: 0;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.32), transparent 90%);
    position: absolute;
  }

  .page-shell {
    margin: 0 auto;
    max-width: var(--content-width);
    padding: 20px 0 48px;
    position: relative;
    z-index: 1;
  }

  .site-header,
  .site-footer {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin: 0 auto;
    padding: 12px 12px 18px;
  }

  .brand {
    align-items: center;
    display: inline-flex;
    gap: 14px;
  }

  .brand__mark {
    background: linear-gradient(135deg, var(--teal) 0%, var(--accent) 100%);
    border-radius: 16px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    color: white;
    display: inline-flex;
    font-family: var(--display-font);
    font-size: 1.1rem;
    font-weight: 700;
    height: 52px;
    justify-content: center;
    letter-spacing: 0.08em;
    padding-top: 2px;
    width: 52px;
  }

  .brand__text {
    display: grid;
    gap: 2px;
  }

  .brand__text strong {
    font-size: 0.98rem;
    font-weight: 700;
  }

  .brand__text small {
    color: var(--muted);
    font-size: 0.84rem;
  }

  .main-shell {
    display: grid;
    gap: 28px;
    padding: 10px 12px 28px;
  }

  .site-footer {
    align-items: flex-start;
    border-top: 1px solid var(--line);
    color: var(--muted);
    flex-direction: column;
    font-size: 0.92rem;
    padding-top: 18px;
  }

  .site-footer p {
    margin: 0;
  }

  .hero__eyebrow,
  .section-kicker,
  .quiz-kicker {
    color: var(--accent-strong);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .hero__title,
  .page-title,
  .section-title,
  .result-title {
    font-family: var(--display-font);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin: 0;
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__lede,
  .page-lede,
  .section-lede {
    color: var(--ink-soft);
    font-size: clamp(1rem, 2vw, 1.16rem);
    margin: 18px 0 0;
  }

  .paper-card,
  .soft-card,
  .metric-card,
  .question-card,
  .result-card,
  .meter-card,
  .empty-card,
  .method-card {
    background: var(--paper);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(77, 53, 26, 0.14);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .soft-card,
  .metric-card,
  .question-card,
  .result-card,
  .meter-card,
  .empty-card,
  .method-card {
    padding: 22px;
  }

  .metric-card,
  .soft-card {
    box-shadow: none;
  }

  .pill-row,
  .language-cloud,
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill,
  .tag,
  .fit-badge,
  .score-badge {
    border-radius: 999px;
    display: inline-flex;
    font-size: 0.92rem;
    font-weight: 600;
    gap: 8px;
    padding: 9px 14px;
  }

  .pill,
  .tag {
    background: rgba(255, 250, 243, 0.92);
    border: 1px solid var(--line);
  }

  .fit-badge {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .score-badge {
    color: var(--teal);
  }

  .button-row,
  .quiz-actions,
  .result-actions,
  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button,
  .button-secondary,
  .button-ghost {
    border-radius: 999px;
    border: 1px solid transparent;
    display: inline-flex;
    font-weight: 700;
    justify-content: center;
    min-width: 132px;
    padding: 13px 20px;
    transition: transform 140ms ease, background 140ms ease, border-color 140ms ease;
  }

  .button:hover,
  .button-secondary:hover,
  .button-ghost:hover {
    transform: translateY(-1px);
  }

  .button {
    background: linear-gradient(135deg, var(--accent) 0%, #d4743d 100%);
    color: white;
  }

  .button-secondary {
    background: rgba(255, 250, 243, 0.82);
    border-color: var(--line);
    color: var(--ink);
  }

  .button-ghost {
    background: transparent;
    border-color: var(--line);
    color: var(--ink-soft);
  }

  .button[disabled],
  .button-secondary[disabled],
  .button-ghost[disabled] {
    cursor: not-allowed;
    opacity: 0.5;
    transform: none;
  }

  section {
    margin-top: 28px;
  }

  .section,
  .quiz-shell,
  .result-shell,
  .method-shell {
    display: grid;
    gap: 18px;
  }

  .section-heading {
    display: grid;
    gap: 10px;
  }

  .section-title,
  .page-title,
  .result-title {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .overline {
    color: var(--muted);
    display: block;
    font-size: 0.84rem;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 680px) {
    .page-shell {
      padding-top: 12px;
    }

    .soft-card,
    .metric-card,
    .question-card,
    .result-card,
    .meter-card,
    .empty-card,
    .method-card {
      padding: 18px;
    }
  }
</style>
