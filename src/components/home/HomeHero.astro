---
import HeroMetrics from './HeroMetrics.astro';

interface Props {
  base: string;
  heroEyebrow: string;
  heroTitle: string;
  heroBlurb: string;
}

const { base, heroEyebrow, heroTitle, heroBlurb } = Astro.props;
---

<section class="hero">
  <p class="hero__eyebrow">{heroEyebrow}</p>
  <h1 class="hero__title">{heroTitle}</h1>
  <p class="hero__lede">{heroBlurb}</p>

  <HeroMetrics />

  <a class="start-test" href={`${base}quiz`}>开始测试</a>
</section>

<style is:global>
  .hero {
    background: linear-gradient(145deg, rgba(255, 250, 243, 0.94), rgba(242, 229, 212, 0.88));
    border: 1px solid rgba(90, 65, 45, 0.14);
    border-radius: calc(var(--radius-lg) + 8px);
    box-shadow: var(--shadow);
    overflow: hidden;
    padding: clamp(24px, 5vw, 48px);
    position: relative;
  }

  .start-test {
    display: block;
    font-size: 1.5rem;
    font-family: var(--display-font);
    font-weight: 700;
    margin-top: 32px;
    padding: 18px 48px;
    text-align: center;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
    color: white;
    border-radius: 999px;
    box-shadow: 0 4px 20px rgba(197, 90, 52, 0.35), 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
    text-decoration: none;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
  }

  .start-test:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 30px rgba(197, 90, 52, 0.45), 0 4px 12px rgba(0, 0, 0, 0.15);
  }

  .start-test:active {
    transform: translateY(0) scale(0.98);
  }

  @media (max-width: 680px) {
    .hero {
      padding: 18px;
    }
  }
</style>
