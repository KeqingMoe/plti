---
import type { DimensionDefinition } from '../../lib/types.ts';

interface Props {
  dimensions: DimensionDefinition[];
}

const { dimensions } = Astro.props;
---

<section class="section">
  <div class="section-heading">
    <p class="section-kicker">维度说明</p>
    <h2 class="section-title">六条轴线，决定你的语言倾向。</h2>
  </div>

  <div class="dimension-grid">
    {
      dimensions.map((dimension) => (
        <article class="soft-card dimension-card">
          <h3>{dimension.name}</h3>
          <p>{dimension.summary}</p>
        </article>
      ))
    }
  </div>
</section>

<style is:global>
  .dimension-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 18px;
  }

  .dimension-card h3 {
    font-family: var(--display-font);
    font-size: 1.45rem;
    margin: 0;
  }

  .dimension-card p {
    color: var(--ink-soft);
    margin: 8px 0 0;
  }

  @media (max-width: 900px) {
    .dimension-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
